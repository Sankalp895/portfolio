---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'missions'>;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const d = entry.data;
const href = `/missions/${entry.id}/`;

const statusLabel: Record<string, string> = {
  verified: 'Verified result',
  'under-review': 'Under review',
  planned: 'Planned',
  shipped: 'Shipped',
};

const statusClass: Record<string, string> = {
  verified: 'badge-verified',
  'under-review': 'badge-review',
  planned: 'badge-planned',
  shipped: 'badge-accent',
};
---

<article class:list={['card', { featured }]} data-categories={d.categories.join(',')}>
  <div class="inner">
    <div class="face front">
      <header class="head">
        <span class:list={['badge', statusClass[d.status]]}>{statusLabel[d.status]}</span>
        <span class="label period">{d.period}</span>
      </header>

      <h3 class="title"><a href={href}>{d.title}</a></h3>
      <p class="tagline">{d.tagline}</p>

      <div class="headline">
        <span class="hv metric">{d.headline.value}</span>
        <span class="hl">{d.headline.label}</span>
      </div>

      <footer class="foot">
        <div class="tags">
          {d.categories.map((c) => <span class="tag">{c}</span>)}
        </div>
        <button type="button" class="flip-btn" data-flip aria-label={`What the first metric hid on ${d.title}`}>
          Second metric
        </button>
      </footer>
    </div>

    <div class="face back" aria-hidden="true">
      <span class="label">What the first metric hid</span>
      <p class="first"><span class="tick">1</span>{d.secondMetric.first}</p>
      <p class="second"><span class="tick two">2</span>{d.secondMetric.second}</p>
      <footer class="foot">
        <a href={href} class="link-arrow">Read the case study</a>
        <button type="button" class="flip-btn" data-flip>Back</button>
      </footer>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    perspective: 1400px;
    min-height: 310px;
  }

  .card.featured { min-height: 350px; }

  .inner {
    position: relative;
    height: 100%;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
  }

  .card.flipped .inner { transform: rotateY(180deg); }

  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem;
    background: var(--panel);
    border: var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    backface-visibility: hidden;
    transition: border-color 0.2s ease;
  }

  .face:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--grid)); }

  .back {
    transform: rotateY(180deg);
    background: var(--panel-raised);
  }

  .card.flipped .back { aria-hidden: false; }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .period { white-space: nowrap; }

  .title {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    margin: 0;
  }

  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }

  .tagline {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .headline {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hv {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .hl {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: var(--rule);
    border-radius: 2px;
    padding: 0.15em 0.45em;
  }

  .flip-btn {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: none;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 2px;
    padding: 0.3em 0.6em;
    cursor: pointer;
    transition: background 0.16s ease;
  }

  .flip-btn:hover { background: var(--accent-soft); }

  .back .first,
  .back .second {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    display: flex;
    gap: 0.6rem;
  }

  .back .first { color: var(--muted); }
  .back .second { color: var(--ink); }

  .tick {
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    border: 1px solid var(--grid);
    border-radius: 50%;
    color: var(--muted);
  }

  .tick.two {
    color: var(--verified);
    border-color: var(--verified);
  }

  .back .foot { margin-top: auto; border-top: var(--rule); }

  @media (prefers-reduced-motion: reduce) {
    .inner { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-flip]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var card = btn.closest('.card');
        if (!card) return;
        var flipped = card.classList.toggle('flipped');
        var back = card.querySelector('.back');
        var front = card.querySelector('.front');
        if (back) back.setAttribute('aria-hidden', String(!flipped));
        if (front) front.setAttribute('aria-hidden', String(flipped));
      });
    });
  })();
</script>
