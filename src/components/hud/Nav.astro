---
const { pathname } = Astro.url;

const routes = [
  { href: '/missions/', label: 'Missions' },
  { href: '/research/', label: 'Research' },
  { href: '/rigor-log/', label: 'Rigor Log' },
  { href: '/skills/', label: 'Skills' },
  { href: '/about/', label: 'About' },
  { href: '/now/', label: 'Now' },
  { href: '/resume/', label: 'Resume' },
];

const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="nav">
  <div class="shell nav-inner">
    <a href="/" class="brand" aria-label="Home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="12" r="7.5"></circle>
          <path d="M2 12h20M12 2c3 3 3 17 0 20M12 2c-3 3-3 17 0 20"></path>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Sankalp Singh</span>
        <span class="brand-sub">The Second Metric</span>
      </span>
    </a>

    <nav class="links" aria-label="Main">
      {routes.map((r) => (
        <a href={r.href} class:list={['link', { active: isActive(r.href) }]}>{r.label}</a>
      ))}
    </nav>

    <div class="tools">
      <button type="button" class="tool" id="open-palette" aria-label="Open command palette">
        <span class="mono">Ctrl</span><span class="mono">K</span>
      </button>
      <button type="button" class="tool theme-toggle" id="theme-toggle" aria-label="Switch between Mission and Paper mode">
        <span class="theme-label" data-theme-label>Mission</span>
      </button>
      <button type="button" class="tool menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18M3 12h18M3 17h18"></path></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="shell">
      {routes.map((r) => <a href={r.href} class="mobile-link">{r.label}</a>)}
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: var(--rule);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark { color: var(--accent); display: flex; }

  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--muted);
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .link:hover { color: var(--ink); }
  .link.active { color: var(--ink); border-bottom-color: var(--accent); }

  .tools { display: flex; align-items: center; gap: 0.4rem; margin-left: 0.5rem; }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 30px;
    padding: 0 0.55rem;
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .tool:hover { color: var(--accent); border-color: var(--accent); }

  .theme-toggle { min-width: 74px; justify-content: center; }
  .menu-btn { display: none; padding: 0 0.4rem; }

  .mobile-menu {
    border-top: var(--rule);
    background: var(--panel);
    padding: 0.5rem 0 1rem;
  }

  .mobile-link {
    display: block;
    padding: 0.6rem 0;
    border-bottom: var(--rule);
    text-decoration: none;
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .links { display: none; }
    .menu-btn { display: inline-flex; }
    #open-palette { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', function () {
        var open = menu.hasAttribute('hidden');
        if (open) { menu.removeAttribute('hidden'); } else { menu.setAttribute('hidden', ''); }
        btn.setAttribute('aria-expanded', String(open));
      });
    }

    var toggle = document.getElementById('theme-toggle');
    function paint() {
      var t = document.documentElement.dataset.theme === 'paper' ? 'Paper' : 'Mission';
      document.querySelectorAll('[data-theme-label]').forEach(function (el) { el.textContent = t; });
    }
    paint();
    if (toggle) {
      toggle.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'paper' ? 'mission' : 'paper';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        paint();
        window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });
    }
  })();
</script>
