---
import { profile } from '@/data/profile';
---

<div class="statusbar">
  <div class="shell statusbar-inner">
    <span class="sb-item sb-live">
      <span class="dot" aria-hidden="true"></span>
      <span class="label">Status</span>
      <span class="sb-value">{profile.status}</span>
    </span>
    <span class="sb-item sb-mission">
      <span class="label">Current mission</span>
      <span class="sb-value">{profile.currentMission}</span>
    </span>
    <span class="sb-item sb-loc">
      <span class="label">Location</span>
      <span class="sb-value">{profile.location}</span>
    </span>
    <span class="sb-item sb-clock">
      <span class="label">UTC</span>
      <time class="sb-value tabular" id="utc-clock" datetime="">--:--:--</time>
    </span>
  </div>
</div>

<style>
  .statusbar {
    border-bottom: var(--rule);
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .statusbar-inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    height: 32px;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .statusbar-inner::-webkit-scrollbar { display: none; }

  .sb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .sb-value {
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .sb-clock { margin-left: auto; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verified);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--verified) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--verified) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* On a phone only the status line fits. The clock is decoration, so it goes first. */
  @media (max-width: 860px) {
    .sb-loc, .sb-mission { display: none; }
  }

  @media (max-width: 560px) {
    .sb-clock { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('utc-clock');
    if (!el) return;
    function tick() {
      var d = new Date();
      var s = d.toISOString();
      el.textContent = s.slice(11, 19) + 'Z';
      el.setAttribute('datetime', s);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
