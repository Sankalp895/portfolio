---
interface Props {
  index: string;
  title: string;
  note?: string;
  href?: string;
  hrefLabel?: string;
}

const { index, title, note, href, hrefLabel } = Astro.props;
---

<header class="sh">
  <span class="idx mono">{index}</span>
  <div class="mid">
    <h2>{title}</h2>
    {note && <p class="note">{note}</p>}
  </div>
  {href && <a href={href} class="link-arrow">{hrefLabel ?? 'See all'}</a>}
</header>

<style>
  .sh {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    border-top: var(--rule);
    padding-top: 1rem;
    margin-bottom: 1.75rem;
  }

  .idx {
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.14em;
    flex-shrink: 0;
    padding-top: 0.25rem;
  }

  .mid { flex: 1; min-width: 0; }

  h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0;
  }

  .note {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 56ch;
  }

  @media (max-width: 640px) {
    .sh { flex-wrap: wrap; gap: 0.6rem 1rem; }
  }
</style>
