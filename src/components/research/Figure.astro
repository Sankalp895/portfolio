---
interface Props {
  paper: string;
  name: string;
  alt: string;
  caption: string;
  source: string;
  /** Rendered width and height of the source PNG, so nothing reflows on load. */
  w: number;
  h: number;
}

const { paper, name, alt, caption, source, w, h } = Astro.props;
const base = `/media/research/${paper}/${name}`;
---

<figure class="fig">
  <button type="button" class="fig-btn" data-lightbox={`${base}.png`} data-alt={alt} aria-label={`Open ${alt} full size`}>
    <img src={`${base}.webp`} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
    <span class="fig-zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4M11 8v6M8 11h6"></path>
      </svg>
    </span>
  </button>
  <figcaption>
    {caption}
    <span class="fig-src mono">
      Source: {source}
      <a href={`${base}.png`} download>download PNG</a>
    </span>
  </figcaption>
</figure>

<style>
  .fig { margin: 2.5rem 0; }

  .fig-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    line-height: 0;
    transition: border-color 0.2s ease;
  }

  .fig-btn:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--grid)); }

  /* The intrinsic size is on the img, so the box is reserved before it loads. */
  .fig-btn img { width: 100%; height: auto; display: block; }

  .fig-zoom {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--panel) 85%, transparent);
    border: var(--rule);
    color: var(--muted);
    backdrop-filter: blur(8px);
  }

  .fig-btn:hover .fig-zoom { color: var(--accent); }

  figcaption {
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .fig-src { font-size: 0.6875rem; opacity: 0.85; display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .fig-src a { color: var(--accent); }
</style>

<script is:inline>
  (function () {
    if (window.__figLightbox) return;
    window.__figLightbox = true;

    var box = null;

    function close() {
      if (!box) return;
      box.remove();
      box = null;
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('[data-lightbox]') : null;
      if (!btn) return;
      close();
      box = document.createElement('div');
      box.className = 'lb';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-modal', 'true');
      var img = document.createElement('img');
      img.src = btn.getAttribute('data-lightbox');
      img.alt = btn.getAttribute('data-alt') || '';
      box.appendChild(img);
      box.addEventListener('click', close);
      document.body.appendChild(box);
      document.body.style.overflow = 'hidden';
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>

<style is:global>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }

  .lb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
  }
</style>
