---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const log = (await getCollection('rigor-log')).sort((a, b) => a.data.order - b.data.order);
const projects = Array.from(new Set(log.map((l) => l.data.project)));
const missions = await getCollection('missions');
const missionIds = new Set(missions.map((m) => m.id));

const hrefFor = (slug?: string) => {
  if (!slug) return null;
  return missionIds.has(slug) ? `/missions/${slug}/` : `/research/${slug}/`;
};
---

<Layout
  title="Rigor Log"
  description="Entries where a second, independent metric disagreed with the first one, with the fix and its source file."
>
  <section class="shell top">
    <p class="eyebrow">Rigor Log</p>
    <h1>Every entry here is a moment I was about to be wrong in public.</h1>
    <p class="lede">
      Each entry records what the first metric said, what a second and independent metric said, the
      fix, and the file it can be checked in.
    </p>

    <div class="stats">
      <div><span class="sv">{log.length}</span><span class="sl">entries</span></div>
      <div><span class="sv">{projects.length}</span><span class="sl">projects</span></div>
      <div><span class="sv">{log.filter((l) => l.data.severity === 'silent').length}</span><span class="sl">would have shipped silently</span></div>
    </div>
  </section>

  <section class="shell">
    <ol class="log">
      {log.map((l) => {
        const d = l.data;
        const href = hrefFor(d.projectSlug);
        return (
          <li class="entry widget reveal" id={l.id}>
            <header>
              <div class="hl">
                <span class="num mono">{String(d.order).padStart(2, '0')}</span>
                <span class:list={['badge', d.severity === 'silent' ? 'badge-todo' : 'badge-accent']}>
                  {d.severity === 'silent' ? 'silent' : 'caught'}
                </span>
              </div>
              <div class="hr">
                {href ? <a href={href} class="proj">{d.project}</a> : <span class="proj">{d.project}</span>}
                {d.source && <span class="src mono">{d.source}</span>}
              </div>
            </header>

            <h2>{d.title}</h2>

            <div class="metrics">
              <div class="m first">
                <span class="mk">First metric said</span>
                <p>{d.firstMetric}</p>
              </div>
              <div class="m second">
                <span class="mk">Second metric said</span>
                <p>{d.secondMetric}</p>
              </div>
            </div>

            <div class="tail">
              <div><span class="mk">Fix</span><p>{d.fix}</p></div>
              <div class="lesson"><span class="mk">Lesson</span><p>{d.lesson}</p></div>
            </div>

            {d.confirm.length > 0 && (
              <div class="todo">
                <span class="badge badge-todo">TODO: confirm</span>
                <ul>{d.confirm.map((c) => <li>{c}</li>)}</ul>
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </section>
</Layout>

<style>
  .top { padding-top: 8rem; margin-bottom: 3.5rem; }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 0.6rem 0 1.25rem;
    max-width: 20ch;
  }

  .lede { margin: 0; max-width: 62ch; color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.6; }

  .stats { display: flex; flex-wrap: wrap; gap: 3rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--hairline); }
  .stats div { display: flex; flex-direction: column; gap: 0.3rem; }
  .sv { font-size: 2.5rem; font-weight: 600; letter-spacing: -0.04em; color: var(--accent); line-height: 1; }
  .sl { font-size: 0.8125rem; color: var(--ink-faint); }

  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }

  .entry { padding: clamp(1.5rem, 3vw, 2.25rem); scroll-margin-top: 5rem; }

  .entry header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hl { display: flex; align-items: center; gap: 0.75rem; }
  .num { font-size: 1rem; color: var(--accent); font-weight: 600; }
  .hr { display: flex; flex-direction: column; align-items: flex-end; gap: 0.2rem; text-align: right; }
  .proj { font-size: 0.75rem; color: var(--ink-soft); text-decoration: none; }
  a.proj:hover { color: var(--accent); }
  .src { font-size: 0.625rem; color: var(--ink-faint); }

  h2 { font-size: clamp(1.25rem, 2.6vw, 1.75rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1.5rem; max-width: 34ch; }

  .metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--hairline); border-radius: 1rem; overflow: hidden; }

  .m { background: var(--surface-solid); padding: 1.35rem; }
  .m.second { border-top: 2px solid var(--accent); }

  .mk { display: block; font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.5rem; }
  .m.second .mk { color: var(--accent); }
  .m p { margin: 0; font-size: 0.9375rem; line-height: 1.65; }
  .m.first p { color: var(--ink-soft); }
  .m.second p { color: var(--ink); }

  .tail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 1.5rem; }
  .tail p { margin: 0; font-size: 0.875rem; line-height: 1.65; color: var(--ink-soft); }
  .lesson p { color: var(--ink); font-weight: 500; }

  .todo {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--accent);
    border-radius: 0.9rem;
    background: var(--accent-wash);
  }

  .todo ul { margin: 0; padding-left: 1.1rem; }
  .todo li { font-size: 0.8125rem; line-height: 1.55; }

  @media (max-width: 800px) {
    .metrics { grid-template-columns: 1fr; }
    .tail { grid-template-columns: 1fr; gap: 1.25rem; }
    .stats { gap: 1.75rem; }
  }
</style>
