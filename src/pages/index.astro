---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import MarsHero from '@/components/MarsHero.tsx';
import DemoVideo from '@/components/DemoVideo.tsx';
import StatTicker from '@/components/StatTicker.tsx';
import MissionCard from '@/components/MissionCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import { profile } from '@/data/profile';
import { hasPhoto } from '@/data/assets';
import { demos } from '@/data/demos';
import { BentoGrid } from '@/components/magicui/bento-grid';
import { DotPattern } from '@/components/magicui/dot-pattern';

const missions = (await getCollection('missions')).sort((a, b) => a.data.order - b.data.order);
const flagship = missions.filter((m) => m.data.flagship);
const papers = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const log = (await getCollection('rigor-log')).sort((a, b) => a.data.order - b.data.order);
const titleFor = (slug: string) => missions.find((m) => m.id === slug)?.data.title ?? slug;

const statusLabel: Record<string, string> = {
  'under-review': 'Under review',
  preprint: 'Preprint',
  published: 'Published',
  'in-preparation': 'In preparation',
};
---

<Layout
  title="home"
  description="Sankalp Singh builds simulations at the edge of machine learning and mathematical modelling: a Mars scout drone, an adversarial drone-swarm defence sim, and two preprints."
>
  <section class="hero">
    <DotPattern client:visible className="hero-dots" width={26} height={26} cr={1} glow={false} />
    <div class="shell">
      <div class="intro">
        {hasPhoto && <img src="/media/portrait.jpg" alt="Sankalp Singh" width="96" height="96" class="portrait" />}
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="line">{profile.identityLine}</p>
        <div class="cta">
          <a href="/missions/" class="btn btn-primary">See the missions</a>
          <a href="/rigor-log/" class="btn btn-ghost">Read the Rigor Log</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento: the hero, the demos, the numbers -->
  <section class="shell bento-wrap">
    <BentoGrid class="bento">
      <div class="tile tile-hero reveal">
        <MarsHero client:visible />
        <p class="caption">
          Illustration of the SkyScout survey, drawn live in your browser from seed 20260808.
          It is not simulator output.
        </p>
      </div>

      <a href="/missions/skyscout/" class="tile tile-num reveal">
        <span class="nv">
          <StatTicker client:visible value={197.57} decimals={2} /> to <StatTicker client:visible value={0.38} decimals={2} /> m
        </span>
        <span class="nl">Position error uncorrected against corrected, over a 40 s flight with 39 fixes</span>
        <span class="nsrc mono">SkyScout</span>
      </a>

      <a href="/missions/skyscout/" class="tile tile-num reveal">
        <span class="nv">
          <StatTicker client:visible value={0.92} decimals={2} /> / <StatTicker client:visible value={0.97} decimals={2} />
        </span>
        <span class="nl">Hazard map F1 and recall against ground truth</span>
        <span class="nsrc mono">SkyScout</span>
      </a>

      <div class="tile tile-demo reveal">
        <DemoVideo client:visible slug={demos[0].slug} title={demos[0].title} durationLabel={demos[0].durationLabel} fill />
        <div class="demo-label">
          <span class="dl-eyebrow">Demo</span>
          <span class="dl-title">{demos[0].title}</span>
        </div>
      </div>

      <a href="/missions/global-weather/" class="tile tile-num reveal">
        <span class="nv"><StatTicker client:visible value={0.0004} decimals={4} /></span>
        <span class="nl">What a Random Forest gained over plain linear regression</span>
        <span class="nsrc mono">Global Weather Forecasting</span>
      </a>

      <a href="/rigor-log/" class="tile tile-num reveal">
        <span class="nv"><StatTicker client:visible value={log.length} /></span>
        <span class="nl">Times a second metric disagreed with the first one</span>
        <span class="nsrc mono">Rigor Log</span>
      </a>
    </BentoGrid>
  </section>

  <div class="shell body">
    <section class="block">
      <SectionHead eyebrow="Demos" title="The work, running" href="/demos/" hrefLabel="All demos" />
      <div class="demo-grid">
        {demos.map((d) => (
          <figure class="demo-card reveal">
            <DemoVideo client:visible slug={d.slug} title={d.title} durationLabel={d.durationLabel} />
            <figcaption>
              <a href={`/missions/${d.slug}/`}>{titleFor(d.slug)}</a>
              <p>{d.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="block">
      <SectionHead eyebrow="Missions" title="Flagship work" href="/missions/" hrefLabel={`All ${missions.length} projects`} />
      <div class="cards">
        {flagship.map((m) => <div class="reveal"><MissionCard entry={m} /></div>)}
      </div>
    </section>

    <section class="block">
      <SectionHead eyebrow="Research" title="Two preprints" href="/research/" hrefLabel="Read both" />
      <div class="papers">
        {papers.map((p) => (
          <article class="paper widget reveal">
            <header>
              <span class="badge badge-accent">{statusLabel[p.data.status]}</span>
              <span class="yr mono">{p.data.year}</span>
            </header>
            <h3><a href={`/research/${p.id}/`}>{p.data.title}</a></h3>
            <p class="abs">{p.data.plainAbstract}</p>
            <ul class="kr">
              {p.data.keyResults.slice(0, 3).map((k) => (
                <li><span class="kv">{k.value}</span><span class="kl">{k.label}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="block">
      <div class="contact widget reveal">
        <div>
          <h2>Open to an M.Sc. place for 2027, and to internships before it.</h2>
          <p>
            If you supervise work in estimation, simulation or the measurement side of machine learning,
            I would like to hear from you. Everything here links back to the code or the paper.
          </p>
        </div>
        <div class="clinks">
          <a href={`mailto:${profile.email}`} class="btn btn-primary">{profile.email}</a>
          <a href={profile.github} target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
          <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero { padding-top: 9rem; position: relative; }

  /* Magic UI DotPattern, masked so it fades out below the name. */
  .hero :global(.hero-dots) {
    position: absolute;
    inset: 0;
    height: 30rem;
    color: var(--dot-strong);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 20%, #000 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 20%, #000 10%, transparent 75%);
    pointer-events: none;
  }
  .intro { text-align: center; max-width: 46rem; margin: 0 auto 3rem; }

  .portrait {
    width: 96px; height: 96px; border-radius: 50%;
    margin: 0 auto 1.75rem; object-fit: cover;
    box-shadow: 0 0 0 1px var(--hairline), 0 12px 32px -16px rgba(0, 0, 0, 0.4);
  }

  h1 { font-size: var(--step-5); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: var(--display); }
  .role { margin: 1rem auto 0; font-size: var(--step-2); color: var(--ink-faint); font-weight: 400; letter-spacing: -0.015em; max-width: 24ch; }
  .line { margin: 1.75rem auto 0; font-size: var(--step-1); line-height: 1.6; color: var(--ink-soft); max-width: 40ch; }
  .cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 2.25rem; }

  .bento-wrap { margin-top: 1rem; }
  .bento { grid-template-columns: repeat(6, minmax(0, 1fr)); }

  .tile {
    border-radius: 1.75rem;
    background: var(--surface);
    backdrop-filter: blur(20px);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, box-shadow 0.35s ease;
  }

  .tile-hero { grid-column: span 6; border: 0; background: none; box-shadow: none; backdrop-filter: none; overflow: visible; }
  .tile-demo { grid-column: span 3; min-height: 17rem; padding: 0; }
  .tile-num { grid-column: span 3; }

  a.tile:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--hairline)); box-shadow: 0 18px 50px -22px rgba(0,0,0,0.3); }

  .tile-num { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.9rem; text-decoration: none; }
  .nv { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.035em; color: var(--accent); line-height: 1.1; text-wrap: balance; }
  .nl { font-size: var(--step-0); color: var(--ink-soft); line-height: 1.5; max-width: 30ch; }
  .nsrc { margin-top: auto; font-size: 0.6875rem; color: var(--ink-faint); }

  .demo-label {
    position: absolute; right: 1.1rem; top: 1.1rem;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.15rem;
    text-align: right; pointer-events: none;
  }
  .dl-eyebrow { font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.72); }
  .dl-title { font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,0.96); max-width: 14rem; }

  .caption { margin: 1rem auto 0; font-size: 0.75rem; color: var(--ink-faint); text-align: center; max-width: 48ch; line-height: 1.5; }

  .body { padding-bottom: 2rem; }
  .block { margin-top: clamp(5rem, 12vw, 9rem); }

  .demo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1.5rem; }
  .demo-card { margin: 0; }
  .demo-card figcaption { margin-top: 1rem; }
  .demo-card figcaption a { font-size: var(--step-1); font-weight: 500; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; }
  .demo-card figcaption a:hover { color: var(--accent); }
  .demo-card figcaption p { margin: 0.4rem 0 0; font-size: 0.875rem; color: var(--ink-faint); line-height: 1.55; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1.25rem; }

  .papers { display: grid; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); gap: 1.25rem; }
  .paper { padding: 1.9rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .paper header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .yr { font-size: 0.75rem; color: var(--ink-faint); }
  .paper h3 { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.025em; }
  .paper h3 a { color: var(--ink); text-decoration: none; }
  .paper h3 a:hover { color: var(--accent); }
  .abs { margin: 0; font-size: var(--step-0); color: var(--ink-soft); line-height: 1.6; }

  .kr { list-style: none; margin: auto 0 0; padding: 1rem 0 0; border-top: 1px solid var(--hairline); display: grid; gap: 0.5rem; }
  .kr li { display: flex; align-items: baseline; gap: 0.9rem; }
  .kv { font-size: 0.9375rem; font-weight: 600; color: var(--accent); min-width: 4.5rem; }
  .kl { font-size: 0.8125rem; color: var(--ink-faint); line-height: 1.45; }

  .contact {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr);
    gap: 2.5rem; align-items: center; padding: clamp(1.8rem, 4vw, 3rem);
  }
  .contact h2 { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; max-width: 22ch; }
  .contact p { margin: 0.9rem 0 0; color: var(--ink-soft); font-size: var(--step-0); line-height: 1.6; max-width: 52ch; }
  .clinks { display: flex; flex-direction: column; gap: 0.6rem; }

  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile-hero, .tile-demo { grid-column: span 2; }
    .tile-num { grid-column: span 1; }
    .contact { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; }
    .tile-hero, .tile-demo, .tile-num { grid-column: span 1; }
  }
</style>
