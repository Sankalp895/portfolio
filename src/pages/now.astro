---
import Layout from '@/layouts/Layout.astro';
import { now } from '@/data/now';
import { profile } from '@/data/profile';

const pretty = new Date(now.updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Now" description="What Sankalp Singh is working on this month: M.Sc. applications for 2027, two preprints, German, cybersecurity and LLM systems engineering.">
  <section class="shell-read top">
    <p class="eyebrow">Now</p>
    <h1>{now.headline}</h1>
    <p class="stamp mono">Updated {pretty} / {now.place}</p>
  </section>

  <section class="shell-read">
    <ol class="items">
      {now.items.map((item) => (
        <li class="reveal">
          <span class="k">{item.label}</span>
          <div class="v">
            <p>{item.body}</p>
            {'confirm' in item && item.confirm && (
              <p class="todo"><span class="badge badge-todo">TODO: confirm</span>{item.confirm}</p>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="foot">
      For anything more current than the date above, <a href={`mailto:${profile.email}`}>email me</a>.
    </p>
  </section>
</Layout>

<style>
  .top { padding-top: 8rem; margin-bottom: 3rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; letter-spacing: -0.04em; margin: 0.6rem 0 1rem; }
  .stamp { font-size: 0.8125rem; color: var(--ink-faint); }

  .items { list-style: none; margin: 0; padding: 0; }
  .items li { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--hairline); }
  .k { font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); padding-top: 0.35rem; }
  .v p { margin: 0; font-size: 1.0625rem; line-height: 1.75; color: var(--ink-soft); }

  .todo { display: flex; gap: 0.7rem; align-items: flex-start; margin-top: 1rem !important; font-size: 0.8125rem !important; color: var(--ink-faint); }

  .foot { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--hairline); font-size: 0.9375rem; color: var(--ink-faint); line-height: 1.6; }
  .foot a { color: var(--accent); }

  @media (max-width: 700px) { .items li { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
