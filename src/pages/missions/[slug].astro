---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ConfirmNote from '@/components/ConfirmNote.astro';
import DemoVideo from '@/components/DemoVideo.tsx';
import { demoFor } from '@/data/demos';

export async function getStaticPaths() {
  const missions = await getCollection('missions');
  const sorted = missions.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const demo = demoFor(entry.id);

const log = (await getCollection('rigor-log'))
  .filter((l) => l.data.projectSlug === entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const sections = headings.filter((h) => h.depth === 2);

const statusLabel: Record<string, string> = {
  verified: 'Verified result',
  'under-review': 'Under review',
  planned: 'Planned',
  shipped: 'Shipped',
};
---

<Layout title={d.title} description={d.tagline}>
  <article>
    <header class="top">
      <div class="shell">
        <nav class="crumbs"><a href="/missions/">Missions</a></nav>
        <p class="eyebrow">{statusLabel[d.status]}</p>
        <h1>{d.title}</h1>
        <p class="tagline">{d.tagline}</p>

        <div class="hero-figure">
          <span class="figure-xl">{d.headline.value}</span>
          <span class="figure-label">{d.headline.label}</span>
          {d.headline.source && <span class="figure-src mono">{d.headline.source}</span>}
        </div>

        <dl class="meta">
          <div><dt>Period</dt><dd class="mono">{d.period}</dd></div>
          <div><dt>Areas</dt><dd class="mono">{d.categories.join(', ')}</dd></div>
          {d.links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd class="links">
                {d.links.map((l) =>
                  l.notPublic ? (
                    <span class="badge badge-quiet">{l.label} not public</span>
                  ) : l.confirm ? (
                    <span class="badge badge-todo">{l.label}: to add</span>
                  ) : (
                    <a href={l.href} target="_blank" rel="noopener" class="ext">{l.label}</a>
                  )
                )}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    {demo && (
      <section class="shell demo-block reveal">
        <DemoVideo client:visible slug={entry.id} title={demo.title} caption={demo.caption} durationLabel={demo.durationLabel} />
      </section>
    )}

    <section class="shell proofs reveal">
      <div class="proof-grid">
        {d.proof.map((p) => (
          <div class="proof widget">
            <span class="pv">{p.value}</span>
            <span class="pl">{p.label}</span>
            {p.source && <span class="ps mono">{p.source}</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- Sticky section nav beside the prose -->
    <div class="shell reading">
      <aside class="toc">
        <nav aria-label="Sections">
          {sections.map((h) => (
            <a href={`#${h.slug}`} class="toc-link" data-toc={h.slug}>{h.text}</a>
          ))}
        </nav>
      </aside>

      <div class="col">
        <ConfirmNote items={d.confirm} />
        <div class="prose-apple"><Content /></div>

        {log.length > 0 && (
          <section class="block">
            <h2 class="sec">From the Rigor Log</h2>
            <div class="logs">
              {log.map((l) => (
                <div class="logitem widget reveal">
                  <h3>{l.data.title}</h3>
                  <p class="lf"><span class="lk">First</span>{l.data.firstMetric}</p>
                  <p class="ls"><span class="lk two">Second</span>{l.data.secondMetric}</p>
                  {l.data.source && <p class="lsrc mono">{l.data.source}</p>}
                </div>
              ))}
            </div>
            <a href="/rigor-log/" class="ext">The whole Rigor Log</a>
          </section>
        )}

        <section class="block">
          <h2 class="sec">Stack</h2>
          <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
        </section>
      </div>
    </div>

    <nav class="shell pager">
      {prev ? (
        <a href={`/missions/${prev.id}/`} class="pg"><span>Previous</span><strong>{prev.data.title}</strong></a>
      ) : <span />}
      {next && (
        <a href={`/missions/${next.id}/`} class="pg right"><span>Next</span><strong>{next.data.title}</strong></a>
      )}
    </nav>
  </article>
</Layout>

<style>
  .top { padding-top: 7.5rem; text-align: center; }

  .crumbs { margin-bottom: 2rem; }
  .crumbs a { font-size: var(--step--1); color: var(--ink-faint); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  h1 { font-size: var(--step-6); font-weight: 600; letter-spacing: -0.045em; margin: 0.5rem 0 1rem; line-height: 0.98; }
  .tagline { margin: 0 auto; font-size: var(--step-2); color: var(--ink-soft); max-width: 34ch; line-height: 1.4; font-weight: 400; }

  .hero-figure { margin: 4.5rem auto 3.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .figure-label { font-size: var(--step-0); color: var(--ink-soft); max-width: 40ch; margin: 0 auto; line-height: 1.5; }
  .figure-src { font-size: var(--step--2); color: var(--ink-faint); }

  .meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem 3rem; margin: 0; padding-top: 2rem; border-top: 1px solid var(--hairline); text-align: left; }
  .meta dt { font-size: var(--step--2); color: var(--ink-faint); letter-spacing: 0.04em; text-transform: uppercase; }
  .meta dd { margin: 0.35rem 0 0; font-size: var(--step--1); }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }

  .ext { font-size: var(--step--1); color: var(--accent); text-decoration: none; }
  .ext:hover { text-decoration: underline; }

  .demo-block { margin-top: 3.5rem; }
  .proofs { margin-top: 3.5rem; }
  .proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
  .proof { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .pv { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.03em; color: var(--accent); line-height: 1.15; }
  .pl { font-size: var(--step--1); color: var(--ink-soft); line-height: 1.5; }
  .ps { font-size: var(--step--2); color: var(--ink-faint); margin-top: 0.3rem; }

  /* Prose with a sticky section list beside it. */
  .reading {
    display: grid;
    grid-template-columns: 13rem minmax(0, 44rem);
    gap: 4rem;
    justify-content: center;
    margin-top: 4.5rem;
  }

  .toc { position: sticky; top: 6rem; align-self: start; padding-top: 0.5rem; }
  .toc nav { display: flex; flex-direction: column; gap: 0.1rem; border-left: 1px solid var(--hairline); }

  .toc-link {
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
    padding: 0.45rem 0 0.45rem 1rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc-link:hover { color: var(--ink); }
  .toc-link.on { color: var(--accent); border-left-color: var(--accent); }

  .col { min-width: 0; }
  .block { margin-top: 4.5rem; }

  .sec { font-size: var(--step-2); font-weight: 600; letter-spacing: -0.03em; padding-top: 2rem; border-top: 1px solid var(--hairline); margin-bottom: 1.5rem; }

  .logs { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  .logitem { padding: 1.5rem; }
  .logitem h3 { font-size: var(--step-1); font-weight: 600; margin-bottom: 0.75rem; }
  .lf, .ls { margin: 0 0 0.5rem; font-size: var(--step--1); line-height: 1.6; }
  .lf { color: var(--ink-faint); }
  .ls { color: var(--ink); }
  .lk { display: inline-block; width: 4rem; font-size: var(--step--2); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .lk.two { color: var(--accent); }
  .lsrc { margin: 0.75rem 0 0; font-size: var(--step--2); color: var(--ink-faint); }

  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; }
  .stack li { font-size: var(--step--1); color: var(--ink-soft); border: 1px solid var(--hairline); border-radius: 999px; padding: 0.35em 0.9em; }

  .pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 6rem; padding-top: 2rem; border-top: 1px solid var(--hairline); }
  .pg { display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; max-width: 45%; }
  .pg span { font-size: var(--step--2); color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.05em; }
  .pg strong { font-size: var(--step-0); font-weight: 500; color: var(--ink); }
  .pg:hover strong { color: var(--accent); }
  .pg.right { text-align: right; margin-left: auto; }

  @media (max-width: 1100px) {
    .reading { grid-template-columns: minmax(0, 44rem); }
    .toc { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'));
    if (!links.length) return;
    var heads = links
      .map(function (l) { return document.getElementById(l.getAttribute('data-toc')); })
      .filter(Boolean);
    if (!heads.length) return;

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (l) {
            l.classList.toggle('on', l.getAttribute('data-toc') === e.target.id);
          });
        });
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );
    heads.forEach(function (h) { io.observe(h); });
  })();
</script>
