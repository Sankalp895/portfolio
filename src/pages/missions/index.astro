---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import MissionCard from '@/components/MissionCard.astro';

const missions = (await getCollection('missions')).sort((a, b) => a.data.order - b.data.order);
const categories = ['All', 'Robotics', 'Simulation', 'Research', 'ML', 'Backend', 'Security'];
const counts = Object.fromEntries(
  categories.map((c) => [
    c,
    c === 'All' ? missions.length : missions.filter((m) => m.data.categories.includes(c as never)).length,
  ])
);
---

<Layout
  title="Missions"
  description="Every project: a Mars scout drone, an adversarial swarm defence sim, a zero-dependency PDF typesetter, a GPS-denied estimator and more."
>
  <section class="shell head">
    <p class="eyebrow">Missions</p>
    <h1>{missions.length} projects, and the number in each one I stopped trusting.</h1>
    <p class="lede">Simulation, estimation and machine learning, across {missions.length} projects.</p>
  </section>

  <section class="shell">
    <div class="filters" role="group" aria-label="Filter projects by area">
      {categories.map((c) => (
        <button type="button" class:list={['chip', { on: c === 'All' }]} data-filter={c}>
          {c}<span class="count mono">{counts[c]}</span>
        </button>
      ))}
    </div>

    <div class="grid" id="grid">
      {missions.map((m) => (
        <div class="cell reveal" data-cats={m.data.categories.join(',')}>
          <MissionCard entry={m} />
        </div>
      ))}
    </div>

    <p class="empty" id="empty" hidden>Nothing in that area yet.</p>
  </section>
</Layout>

<style>
  .head { padding-top: 8rem; margin-bottom: 3rem; }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 0.6rem 0 1.25rem;
    max-width: 18ch;
  }

  .lede { margin: 0; max-width: 56ch; color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.6; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .chip:hover { color: var(--ink); }
  .chip.on { color: #fff; background: var(--ink); border-color: var(--ink); }

  .count { font-size: 0.6875rem; opacity: 0.6; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.25rem; }
  .cell[hidden] { display: none; }
  .empty { color: var(--ink-faint); padding: 3rem 0; }
</style>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('[data-filter]');
    var cells = document.querySelectorAll('#grid .cell');
    var empty = document.getElementById('empty');

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var want = chip.getAttribute('data-filter');
        chips.forEach(function (c) { c.classList.toggle('on', c === chip); });

        var shown = 0;
        cells.forEach(function (cell) {
          var cats = (cell.getAttribute('data-cats') || '').split(',');
          var show = want === 'All' || cats.indexOf(want) !== -1;
          if (show) { cell.removeAttribute('hidden'); shown++; } else { cell.setAttribute('hidden', ''); }
        });

        if (empty) {
          if (shown === 0) { empty.removeAttribute('hidden'); } else { empty.setAttribute('hidden', ''); }
        }
      });
    });
  })();
</script>
