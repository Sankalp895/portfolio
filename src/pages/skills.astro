---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ConfirmNote from '@/components/ConfirmNote.astro';
import { skillGroups, learning } from '@/data/skills';
import { workRefs } from '@/data/projects';

const missions = await getCollection('missions');
const research = await getCollection('research');

const projectIndex = new Map<string, { title: string; href: string }>();
missions.forEach((m) => projectIndex.set(m.id, { title: m.data.title, href: `/missions/${m.id}/` }));
research.forEach((r) => projectIndex.set(r.id, { title: r.data.title, href: `/research/${r.id}/` }));
workRefs.forEach((w) => projectIndex.set(w.slug, { title: w.title, href: w.href }));

const missingEvidence: string[] = [];
const unknownRefs: string[] = [];

for (const g of skillGroups) {
  for (const s of g.skills) {
    if (s.evidence.length === 0) {
      // noLink means this is settled, not an outstanding task, so it raises no TODO.
      if (!s.noLink) missingEvidence.push(`${s.name}: no project links to it yet${s.note ? `. ${s.note}` : ''}`);
      continue;
    }
    for (const e of s.evidence) {
      if (!projectIndex.has(e)) unknownRefs.push(`${s.name} points at "${e}", which is not a project on this site.`);
    }
  }
}

const confirmItems = [
  ...missingEvidence,
  ...unknownRefs,
  ...skillGroups.flatMap((g) =>
    g.skills.filter((s) => s.confirm && s.evidence.length).map((s) => `${s.name}: ${s.note ?? 'confirm before using'}`)
  ),
];

const totalSkills = skillGroups.reduce((n, g) => n + g.skills.length, 0);
---

<Layout
  title="Skills"
  description="Skills, each linked to the project it was used on."
>
  <section class="shell top">
    <p class="eyebrow">Skills</p>
    <h1>{totalSkills} skills</h1>
    <p class="lede">Each one links to the project it was used on.</p>
  </section>

  <section class="shell">
    <ConfirmNote items={confirmItems} />

    {skillGroups.map((g) => (
      <div class="grp reveal">
        <h2>{g.label}</h2>
        <ul class="rows">
          {g.skills.map((s) => (
            <li>
              <span class="sname">{s.name}</span>
              <span class="ev">
                {s.evidence.length === 0 ? (
                  <span class={s.noLink ? 'nolink' : 'none'}>
                    {s.noLink ? s.note ?? 'no public project links to it' : 'no project linked yet'}
                  </span>
                ) : (
                  s.evidence.map((e) =>
                    projectIndex.has(e) ? (
                      <a href={projectIndex.get(e)!.href}>{projectIndex.get(e)!.title}</a>
                    ) : (
                      <span class="none">{e}</span>
                    )
                  )
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="shell learning reveal">
    <h2>Currently learning</h2>
    <div class="lgrid">
      {learning.map((l) => (
        <div class="lcard widget">
          <span class="ln">{l.name}</span>
          <span class="ld">{l.detail}</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .top { padding-top: 8rem; margin-bottom: 3rem; }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 0.6rem 0 1.25rem;
    max-width: 20ch;
  }

  .lede { margin: 0; max-width: 58ch; color: var(--ink-soft); font-size: 1.0625rem; line-height: 1.6; }

  .grp { margin-bottom: 3.5rem; }

  .grp h2 {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .rows { list-style: none; margin: 0; padding: 0; }

  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .sname { font-size: 1rem; color: var(--ink); }
  .ev { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; align-items: baseline; }
  .ev a { font-size: 0.875rem; color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--hairline); }
  .ev a:hover { color: var(--accent); border-color: var(--accent); }
  .none { font-size: 0.8125rem; color: var(--accent); }
  .nolink { font-size: 0.8125rem; color: var(--ink-faint); }

  .learning { margin-top: 2rem; }
  .learning h2 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1.5rem; padding-top: 2rem; border-top: 1px solid var(--hairline); }
  .lgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .lcard { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .ln { font-size: 1.0625rem; font-weight: 500; }
  .ld { font-size: 0.875rem; color: var(--ink-faint); }

  @media (max-width: 700px) {
    .rows li { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
