---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SkillGraph from '@/components/graph/SkillGraph.tsx';
import ConfirmNote from '@/components/cards/ConfirmNote.astro';
import { skillGroups, learning } from '@/data/skills';
import { workRefs } from '@/data/projects';

const missions = await getCollection('missions');
const research = await getCollection('research');

const projectIndex = new Map<string, { title: string; href: string }>();
missions.forEach((m) => projectIndex.set(m.id, { title: m.data.title, href: `/missions/${m.id}/` }));
research.forEach((r) => projectIndex.set(r.id, { title: r.data.title, href: `/research/${r.id}/` }));
workRefs.forEach((w) => projectIndex.set(w.slug, { title: w.title, href: w.href }));

// Build the graph. A skill with no evidence is left out of the graph on purpose and
// listed as a TODO below, because the rule is that every skill must link to a project.
const usedProjects = new Set<string>();
const skillNodes: { id: string; label: string; kind: 'skill'; group: string }[] = [];
const graphLinks: { source: string; target: string }[] = [];
const missingEvidence: string[] = [];
const unknownRefs: string[] = [];

for (const g of skillGroups) {
  for (const s of g.skills) {
    if (s.evidence.length === 0) {
      // noLink means this is settled, not an outstanding task, so it raises no TODO.
      if (!s.noLink) {
        missingEvidence.push(`${s.name}: no project links to it yet${s.note ? `. ${s.note}` : ''}`);
      }
      continue;
    }
    const id = `s:${s.name}`;
    skillNodes.push({ id, label: s.name, kind: 'skill', group: g.id });
    for (const e of s.evidence) {
      if (!projectIndex.has(e)) {
        unknownRefs.push(`${s.name} points at "${e}", which is not a project on this site.`);
        continue;
      }
      usedProjects.add(e);
      graphLinks.push({ source: id, target: `p:${e}` });
    }
  }
}

const projectNodes = Array.from(usedProjects).map((slug) => ({
  id: `p:${slug}`,
  label: projectIndex.get(slug)!.title,
  kind: 'project' as const,
  href: projectIndex.get(slug)!.href,
}));

const graphNodes = [...projectNodes, ...skillNodes];
const groups = skillGroups.map((g) => ({ id: g.id, label: g.label }));

const confirmItems = [
  ...missingEvidence,
  ...unknownRefs,
  ...skillGroups.flatMap((g) => g.skills.filter((s) => s.confirm && s.evidence.length).map((s) => `${s.name}: ${s.note ?? 'confirm before using'}`)),
];
---

<Base
  title="Skills"
  description="An evidence map: every skill links to the project that proves it. No percentage bars."
>
  <section class="shell top">
    <p class="label">Skills</p>
    <h1>No percentage bars. Every skill points at the project that proves it.</h1>
    <p class="lede">
      A bar saying "Python 90%" is a number I made up about myself. Instead, each skill below is a node
      linked to the work where I actually used it. Click a node to see what it connects to. The same
      information is in the table underneath, which works without JavaScript.
    </p>
  </section>

  <section class="shell">
    <SkillGraph client:visible nodes={graphNodes} links={graphLinks} groups={groups} />
    <ConfirmNote items={confirmItems} />
  </section>

  <section class="shell table-wrap">
    <h2 class="sub">The same map, as a table</h2>
    {skillGroups.map((g) => (
      <div class="grp">
        <h3>{g.label}</h3>
        <ul>
          {g.skills.map((s) => (
            <li>
              <span class="sname">
                {s.name}
                {s.confirm && <span class="todo-dot" title="Needs confirming">TODO</span>}
              </span>
              <span class="ev">
                {s.evidence.length === 0 ? (
                  <span class={s.noLink ? 'nolink' : 'none'}>
                    {s.noLink ? s.note ?? 'no public project links to it' : 'no project linked yet'}
                  </span>
                ) : (
                  s.evidence.map((e) =>
                    projectIndex.has(e) ? (
                      <a href={projectIndex.get(e)!.href}>{projectIndex.get(e)!.title}</a>
                    ) : (
                      <span class="none">{e}</span>
                    )
                  )
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="shell learning">
    <h2 class="sub">Currently learning</h2>
    <ul class="learn">
      {learning.map((l) => (
        <li>
          <span class="ln">{l.name}</span>
          <span class="ld">{l.detail}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .top { padding-top: clamp(2rem, 5vw, 3.5rem); margin-bottom: 2.5rem; }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0.75rem 0 0.9rem;
    max-width: 22ch;
  }

  .lede {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .table-wrap, .learning { margin-top: 3.5rem; }

  .sub {
    font-size: 1.4rem;
    padding-top: 1.25rem;
    border-top: var(--rule);
    margin-bottom: 1.5rem;
  }

  .grp { margin-bottom: 2rem; }

  .grp h3 {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .grp ul { list-style: none; margin: 0; padding: 0; }

  .grp li {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: var(--rule);
  }

  .sname { font-size: 0.9375rem; display: flex; align-items: center; gap: 0.5rem; }

  .todo-dot {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--warn);
    border: 1px solid currentColor;
    border-radius: 2px;
    padding: 0.05em 0.3em;
  }

  .ev { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: 0.8125rem; }
  .ev a { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--grid); }
  .ev a:hover { color: var(--accent); border-color: var(--accent); }
  .none { color: var(--warn); font-family: var(--font-mono); font-size: 0.75rem; }
  /* Settled, not outstanding: no link is the correct answer here. */
  .nolink { color: var(--muted); font-family: var(--font-mono); font-size: 0.75rem; }

  .learn { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }

  .learn li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: var(--rule);
  }

  .ln { font-size: 1rem; min-width: 14rem; }
  .ld { font-size: 0.875rem; color: var(--muted); }

  @media (max-width: 700px) {
    .grp li { grid-template-columns: 1fr; gap: 0.3rem; }
    .learn li { flex-direction: column; gap: 0.2rem; }
    .ln { min-width: 0; }
  }
</style>
