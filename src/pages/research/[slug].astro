---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ConfirmNote from '@/components/cards/ConfirmNote.astro';
import Figure from '@/components/research/Figure.astro';
import InlineFigure from '@/components/research/InlineFigure.astro';
import { grokkingFigures, surrogateFigures } from '@/data/research/figures';
import { grokkingFiles, surrogateFiles } from '@/data/research/files';
import { hasResumePdf } from '@/data/assets';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  const sorted = papers.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, other: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, other } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const isGrokking = entry.id === 'lead-time-is-not-a-detection';
const figures = isGrokking ? grokkingFigures : surrogateFigures;
const files = isGrokking ? grokkingFiles : surrogateFiles;
const paperDir = isGrokking ? 'grokking' : 'surrogate-trust-audit';
// A hero of "inline:name" is one of the redrawn SVGs; anything else is a key in
// the paper's figure map.
const heroInline = d.heroFigure.startsWith('inline:') ? d.heroFigure.slice(7) : null;
const hero = heroInline ? null : figures[d.heroFigure];
const heroCaption = entry.id === 'lead-time-is-not-a-detection'
  ? 'Train accuracy reaches 1.0 by step 500. Test accuracy sits at chance for thousands of steps, then jumps at 4,100. The shaded band is the gap the paper is about.'
  : 'The preregistered test. Every indicator class sits left of zero against the input-only null, and no interval crosses it.';
const heroSource = entry.id === 'lead-time-is-not-a-detection' ? 'logs/single.csv' : 'tables/primary_h4.csv';

// Entries in the Rigor Log that came out of this paper.
const log = (await getCollection('rigor-log'))
  .filter((l) => l.data.projectSlug === entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const sections = headings.filter((h) => h.depth === 2);
const pdfLink = d.links.find((l) => l.label === 'PDF' && !l.confirm && l.href);
const codeLink = d.links.find((l) => l.label === 'Code' && !l.confirm && !l.notPublic && l.href);
const codeNotPublic = d.links.some((l) => l.label === 'Code' && l.notPublic);
---

<Base title={d.title} description={d.oneLine} wide={false}>
  <article>
    <header class="shell top">
      <nav class="crumbs"><a href="/research/">Research</a></nav>

      <span class="badge badge-review">Preprint</span>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}
      <p class="one">{d.oneLine}</p>

      <div class="acts">
        {pdfLink ? (
          <a href={pdfLink.href} class="btn btn-accent" target="_blank" rel="noopener">Read the PDF</a>
        ) : (
          <span class="badge badge-review">PDF: to add</span>
        )}
        {codeLink && <a href={codeLink.href} class="btn" target="_blank" rel="noopener">Code on GitHub</a>}
        {codeNotPublic && <span class="badge badge-planned">Code not public</span>}
        <button type="button" class="btn copy-bib" data-bib={d.bibtex}>Copy BibTeX</button>
      </div>

      <p class="honest">{d.statusDetail} Not peer reviewed.</p>
    </header>

    <div class="shell hero-fig">
      {heroInline ? (
        <InlineFigure name={heroInline} caption={heroCaption} source={heroSource} />
      ) : hero ? (
        <Figure paper={paperDir} name={hero.name} alt={hero.alt} caption={hero.caption} source={hero.source} w={hero.w} h={hero.h} />
      ) : null}
    </div>

    <section class="shell results-strip">
      <div class="rgrid">
        {d.keyResults.map((k) => (
          <div class="r">
            <span class="rv metric">{k.value}</span>
            <span class="rl">{k.label}</span>
            {k.source && <span class="rs mono">{k.source}</span>}
          </div>
        ))}
      </div>
    </section>

    <div class="shell reading">
      <aside class="toc">
        <nav aria-label="Sections">
          {sections.map((h) => (
            <a href={`#${h.slug}`} class="toc-link" data-toc={h.slug}>{h.text}</a>
          ))}
          <a href="#files" class="toc-link" data-toc="files">Files</a>
        </nav>
      </aside>

      <div class="col">
        <ConfirmNote items={d.confirm} />
        <div class="prose-paper"><Content /></div>

        {log.length > 0 && (
          <section class="block">
            <h2 class="sec">From the Rigor Log</h2>
            <div class="logs">
              {log.map((l) => (
                <div class="logitem">
                  <h3>{l.data.title}</h3>
                  <p class="lf"><span class="lk">First</span>{l.data.firstMetric}</p>
                  <p class="ls"><span class="lk two">Second</span>{l.data.secondMetric}</p>
                  {l.data.source && <p class="lsrc mono">{l.data.source}</p>}
                </div>
              ))}
            </div>
            <a href="/rigor-log/" class="link-arrow">The whole Rigor Log</a>
          </section>
        )}

        <section class="block" id="files">
          <h2 class="sec">Files</h2>
          <p class="fnote">
            The result artefacts these pages are built from. Every number above is read
            from one of these.
          </p>
          <ul class="files">
            {files.map((f) => (
              <li>
                <span class="fp mono">{f.path}</span>
                <span class="fd">{f.desc}</span>
                <span class="fs mono">{f.size}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <h2 class="sec">Stack</h2>
          <ul class="stack">{d.stack.map((s) => <li class="mono">{s}</li>)}</ul>
        </section>
      </div>
    </div>

    <nav class="shell pager">
      <a href="/research/" class="pg"><span class="label">Back</span><span>All research</span></a>
      {other && other.id !== entry.id && (
        <a href={`/research/${other.id}/`} class="pg right"><span class="label">The other paper</span><span>{other.data.title}</span></a>
      )}
    </nav>
  </article>
</Base>

<style>
  .top { padding-top: clamp(1.75rem, 4vw, 3rem); }

  .crumbs { margin-bottom: 1.75rem; }
  .crumbs a { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    margin: 0.9rem 0 0.5rem;
    max-width: 22ch;
  }

  .sub { margin: 0 0 1.25rem; font-size: 1.15rem; color: var(--muted); font-family: var(--font-serif); }

  .one {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.55;
    max-width: 54ch;
  }

  .acts { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 1.9rem 0 1rem; }
  .honest { margin: 0; font-size: 0.75rem; color: var(--muted); }

  .hero-fig { margin-top: 1rem; }

  .results-strip { margin-top: 2rem; }

  .rgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--grid);
    border: var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .r { background: var(--panel); padding: 1.1rem 1.15rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .rv { font-size: 1.4rem; line-height: 1.15; }
  .rl { font-size: 0.75rem; color: var(--muted); line-height: 1.45; }
  .rs { font-size: 0.5625rem; color: var(--muted); opacity: 0.75; margin-top: 0.25rem; }

  .reading {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3.5rem;
  }

  .toc { position: sticky; top: 100px; align-self: start; }
  .toc nav { display: flex; flex-direction: column; border-left: var(--rule); }

  .toc-link {
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.42rem 0 0.42rem 0.9rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .toc-link:hover { color: var(--ink); }
  .toc-link.on { color: var(--accent); border-left-color: var(--accent); }

  .col { min-width: 0; }
  .block { margin-top: 3.5rem; }

  .sec {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    padding-top: 1.25rem;
    border-top: var(--rule);
    margin-bottom: 1.25rem;
  }

  .logs { display: grid; gap: 1rem; margin-bottom: 1.25rem; }
  .logitem { border-left: 2px solid var(--accent); padding: 0.15rem 0 0.15rem 1rem; }
  .logitem h3 { font-size: 1.05rem; margin: 0 0 0.45rem; }
  .lf, .ls { margin: 0 0 0.35rem; font-size: 0.875rem; line-height: 1.55; }
  .lf { color: var(--muted); }
  .lk { display: inline-block; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); width: 4.2rem; }
  .lk.two { color: var(--verified); }
  .lsrc { margin: 0.5rem 0 0; font-size: 0.625rem; color: var(--muted); }

  .fnote { margin: 0 0 1.25rem; font-size: 0.875rem; color: var(--muted); line-height: 1.6; }

  .files { list-style: none; margin: 0; padding: 0; }

  .files li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: var(--rule);
    align-items: baseline;
  }

  .fp { font-size: 0.75rem; color: var(--ink); word-break: break-all; }
  .fd { font-size: 0.8125rem; color: var(--muted); line-height: 1.5; }
  .fs { font-size: 0.6875rem; color: var(--muted); white-space: nowrap; }

  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; }
  .stack li { font-size: 0.75rem; color: var(--muted); border: var(--rule); border-radius: 2px; padding: 0.3em 0.6em; }

  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 1.25rem; border-top: var(--rule); }
  .pg { display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; font-size: 0.9375rem; max-width: 45%; }
  .pg.right { text-align: right; margin-left: auto; }
  .pg:hover { color: var(--accent); }

  @media (max-width: 1000px) {
    .reading { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
    .files li { grid-template-columns: 1fr auto; }
    .fd { grid-column: 1 / -1; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.copy-bib').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-bib') || '';
        var done = function () {
          var old = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = old; }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(function () { btn.textContent = 'Copy failed'; });
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = 'Copy failed'; }
          document.body.removeChild(ta);
        }
      });
    });

    var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'));
    var heads = links.map(function (l) { return document.getElementById(l.getAttribute('data-toc')); }).filter(Boolean);
    if (!heads.length) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (l) { l.classList.toggle('on', l.getAttribute('data-toc') === e.target.id); });
        });
      },
      { rootMargin: '-12% 0px -72% 0px' }
    );
    heads.forEach(function (h) { io.observe(h); });
  })();
</script>
