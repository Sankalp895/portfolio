---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ConfirmNote from '@/components/ConfirmNote.astro';
import Figure from '@/components/research/Figure.astro';
import InlineFigure from '@/components/research/InlineFigure.astro';
import { grokkingFigures, surrogateFigures } from '@/data/research/figures';
import { grokkingFiles, surrogateFiles } from '@/data/research/files';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  const sorted = papers.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, other: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, other } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const isGrokking = entry.id === 'lead-time-is-not-a-detection';
const figures = isGrokking ? grokkingFigures : surrogateFigures;
const files = isGrokking ? grokkingFiles : surrogateFiles;
const paperDir = isGrokking ? 'grokking' : 'surrogate-trust-audit';
// A hero of "inline:name" is one of the redrawn SVGs; anything else is a key in
// the paper's figure map.
const heroInline = d.heroFigure.startsWith('inline:') ? d.heroFigure.slice(7) : null;
const hero = heroInline ? null : figures[d.heroFigure];
const heroCaption = isGrokking
  ? 'Train accuracy reaches 1.0 by step 500. Test accuracy sits at chance for thousands of steps, then jumps at 4,100. The shaded band is the gap the paper is about.'
  : 'The preregistered test. Every indicator class sits left of zero against the input-only null, and no interval crosses it.';
const heroSource = isGrokking ? 'logs/single.csv' : 'tables/primary_h4.csv';

// Entries in the Rigor Log that came out of this paper.
const log = (await getCollection('rigor-log'))
  .filter((l) => l.data.projectSlug === entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const sections = headings.filter((h) => h.depth === 2);
const pdfLink = d.links.find((l) => l.label === 'PDF' && !l.confirm && l.href);
const codeLink = d.links.find((l) => l.label === 'Code' && !l.confirm && !l.notPublic && l.href);
const codeNotPublic = d.links.some((l) => l.label === 'Code' && l.notPublic);
---

<Layout title={d.title} description={d.oneLine}>
  <article>
    <header class="shell-read top">
      <nav class="crumbs"><a href="/research/">Research</a></nav>

      <span class="badge badge-accent">Preprint</span>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}
      <p class="one">{d.oneLine}</p>

      <div class="acts">
        {pdfLink ? (
          <a href={pdfLink.href} class="btn btn-primary" target="_blank" rel="noopener">Read the PDF</a>
        ) : (
          <span class="badge badge-todo">PDF: to add</span>
        )}
        {codeLink && <a href={codeLink.href} class="btn btn-ghost" target="_blank" rel="noopener">Code on GitHub</a>}
        {codeNotPublic && <span class="badge badge-quiet">Code not public</span>}
        <button type="button" class="btn btn-ghost copy-bib" data-bib={d.bibtex}>Copy BibTeX</button>
      </div>

      <p class="honest">{d.statusDetail} Not peer reviewed.</p>
    </header>

    <div class="shell hero-fig">
      {heroInline ? (
        <InlineFigure name={heroInline} caption={heroCaption} source={heroSource} />
      ) : hero ? (
        <Figure paper={paperDir} name={hero.name} alt={hero.alt} caption={hero.caption} source={hero.source} w={hero.w} h={hero.h} />
      ) : null}
    </div>

    <section class="shell results-strip">
      <div class="rgrid">
        {d.keyResults.map((k) => (
          <div class="r">
            <span class="rv">{k.value}</span>
            <span class="rl">{k.label}</span>
            {k.source && <span class="rs mono">{k.source}</span>}
          </div>
        ))}
      </div>
    </section>

    <div class="shell reading">
      <aside class="toc">
        <nav aria-label="Sections">
          {sections.map((h) => (
            <a href={`#${h.slug}`} class="toc-link" data-toc={h.slug}>{h.text}</a>
          ))}
          <a href="#files" class="toc-link" data-toc="files">Files</a>
        </nav>
      </aside>

      <div class="col">
        <ConfirmNote items={d.confirm} />
        <div class="prose-apple"><Content /></div>

        {log.length > 0 && (
          <section class="block">
            <h2 class="sec">From the Rigor Log</h2>
            <div class="logs">
              {log.map((l) => (
                <div class="logitem">
                  <h3>{l.data.title}</h3>
                  <p class="lf"><span class="lk">First</span>{l.data.firstMetric}</p>
                  <p class="ls"><span class="lk two">Second</span>{l.data.secondMetric}</p>
                  {l.data.source && <p class="lsrc mono">{l.data.source}</p>}
                </div>
              ))}
            </div>
            <a href="/rigor-log/" class="more">The whole Rigor Log</a>
          </section>
        )}

        <section class="block" id="files">
          <h2 class="sec">Files</h2>
          <p class="fnote">
            The result artefacts these pages are built from. Every number above is read
            from one of these.
          </p>
          <ul class="files">
            {files.map((f) => (
              <li>
                <span class="fp mono">{f.path}</span>
                <span class="fd">{f.desc}</span>
                <span class="fs mono">{f.size}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <h2 class="sec">Stack</h2>
          <ul class="stack">{d.stack.map((s) => <li class="mono">{s}</li>)}</ul>
        </section>
      </div>
    </div>

    <nav class="shell pager">
      <a href="/research/" class="pg"><span class="label mono">Back</span><span>All research</span></a>
      {other && other.id !== entry.id && (
        <a href={`/research/${other.id}/`} class="pg right"><span class="label mono">The other paper</span><span>{other.data.title}</span></a>
      )}
    </nav>
  </article>
</Layout>

<style>
  .top { padding-top: clamp(2rem, 5vw, 4rem); }

  .crumbs { margin-bottom: 1.75rem; }
  .crumbs a {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .crumbs a:hover { color: var(--accent); }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin: 0.9rem 0 0.6rem;
    max-width: 18ch;
  }

  .sub {
    margin: 0 0 1.5rem;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    color: var(--ink-soft);
  }

  .one {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    letter-spacing: -0.01em;
    max-width: 46ch;
  }

  .acts { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 2.25rem 0 1rem; }
  .honest { margin: 0; font-size: 0.8125rem; color: var(--ink-faint); }

  .hero-fig { margin-top: 2.5rem; }

  .results-strip { margin-top: 3rem; }

  .rgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--hairline);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .r { background: var(--surface-solid); padding: 1.35rem 1.25rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .rv { font-size: 1.75rem; letter-spacing: -0.02em; line-height: 1.1; color: var(--accent); }
  .rl { font-size: 0.8125rem; color: var(--ink-soft); line-height: 1.45; }
  .rs { font-size: 0.625rem; color: var(--ink-faint); margin-top: 0.3rem; }

  .reading {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3.5rem;
    margin-top: 4rem;
  }

  .toc { position: sticky; top: 92px; align-self: start; }
  .toc nav { display: flex; flex-direction: column; border-left: 1px solid var(--hairline); }

  .toc-link {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.45rem 0 0.45rem 1rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .toc-link:hover { color: var(--ink); }
  .toc-link.on { color: var(--accent); border-left-color: var(--accent); }

  .col { min-width: 0; }
  .block { margin-top: 4rem; }

  .sec {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    margin-bottom: 1.5rem;
  }

  .logs { display: grid; gap: 1.1rem; margin-bottom: 1.25rem; }
  .logitem { border-left: 2px solid var(--accent); padding: 0.15rem 0 0.15rem 1.1rem; }
  .logitem h3 { font-size: 1.0625rem; letter-spacing: -0.01em; margin: 0 0 0.5rem; }
  .lf, .ls { margin: 0 0 0.35rem; font-size: 0.9375rem; line-height: 1.55; }
  .lf { color: var(--ink-soft); }
  .lk {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    width: 4.4rem;
  }
  .lk.two { color: var(--verified); }
  .lsrc { margin: 0.5rem 0 0; font-size: 0.6875rem; color: var(--ink-faint); }

  .more { font-size: 0.9375rem; color: var(--accent); text-decoration: none; }
  .more::after { content: ' \2192'; }
  .more:hover { text-decoration: underline; }

  .fnote { margin: 0 0 1.5rem; font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.6; }

  .files { list-style: none; margin: 0; padding: 0; }

  .files li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
  }

  .fp { font-size: 0.75rem; color: var(--ink); word-break: break-all; }
  .fd { font-size: 0.8125rem; color: var(--ink-soft); line-height: 1.5; }
  .fs { font-size: 0.6875rem; color: var(--ink-faint); white-space: nowrap; }

  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0; margin: 0; }
  .stack li {
    font-size: 0.75rem;
    color: var(--ink-soft);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.35em 0.85em;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .pg { display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; font-size: 1rem; max-width: 45%; }
  .pg.right { text-align: right; margin-left: auto; }
  .pg .label { font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .pg:hover { color: var(--accent); }

  @media (max-width: 1000px) {
    .reading { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
    .files li { grid-template-columns: 1fr auto; }
    .fd { grid-column: 1 / -1; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.copy-bib').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-bib') || '';
        var done = function () {
          var old = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = old; }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(function () { btn.textContent = 'Copy failed'; });
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = 'Copy failed'; }
          document.body.removeChild(ta);
        }
      });
    });

    var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'));
    var heads = links.map(function (l) { return document.getElementById(l.getAttribute('data-toc')); }).filter(Boolean);
    if (!heads.length) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (l) { l.classList.toggle('on', l.getAttribute('data-toc') === e.target.id); });
        });
      },
      { rootMargin: '-12% 0px -72% 0px' }
    );
    heads.forEach(function (h) { io.observe(h); });
  })();
</script>
