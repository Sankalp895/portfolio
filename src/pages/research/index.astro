---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { grokkingFigures, surrogateFigures } from '@/data/research/figures';

const papers = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const figFor = (id: string) =>
  id === 'lead-time-is-not-a-detection'
    ? { dir: 'grokking', fig: grokkingFigures.curve }
    : { dir: 'surrogate-trust-audit', fig: surrogateFigures.nullComparison };
---

<Base
  title="Research"
  description="Two preprints: an audit of grokking early-warning signals, and a null-model audit of trust signals for neural PDE surrogates."
>
  <section class="shell top">
    <p class="label">Research</p>
    <h1>Two preprints</h1>
    <p class="lede">
      One audits early-warning signals for grokking. One audits trust signals for neural PDE
      surrogates against an input-only null model. Both pages carry the figures and the result
      files the numbers come from.
    </p>
  </section>

  <section class="shell list">
    {papers.map((p) => {
      const { dir, fig } = figFor(p.id);
      return (
        <article class="paper reveal">
          <a href={`/research/${p.id}/`} class="shot" aria-hidden="true" tabindex="-1">
            <img src={`/media/research/${dir}/${fig.name}.webp`} alt="" width={fig.w} height={fig.h} loading="lazy" decoding="async" />
          </a>
          <div class="body">
            <div class="row">
              <span class="badge badge-review">Preprint</span>
              <span class="label">{p.data.year}</span>
            </div>
            <h2><a href={`/research/${p.id}/`}>{p.data.title}</a></h2>
            {p.data.subtitle && <p class="sub">{p.data.subtitle}</p>}
            <p class="one">{p.data.oneLine}</p>
            <ul class="kr">
              {p.data.keyResults.slice(0, 3).map((k) => (
                <li><span class="kv metric">{k.value}</span><span class="kl">{k.label}</span></li>
              ))}
            </ul>
            <a href={`/research/${p.id}/`} class="link-arrow">Read the page</a>
          </div>
        </article>
      );
    })}
  </section>
</Base>

<style>
  .top { padding-top: clamp(2rem, 5vw, 3.5rem); margin-bottom: 3rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin: 0.75rem 0 0.9rem; }
  .lede { margin: 0; max-width: 62ch; color: var(--muted); font-size: 1.0625rem; line-height: 1.6; }

  .list { display: grid; gap: 3rem; }

  .paper {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-top: 2.5rem;
    border-top: var(--rule);
  }

  .shot {
    display: block;
    border: var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    line-height: 0;
    transition: border-color 0.2s ease;
  }

  .shot:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--grid)); }
  .shot img { width: 100%; height: auto; display: block; }

  .row { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.9rem; }

  h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0 0 0.45rem; }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--accent); }

  .sub { margin: 0 0 0.9rem; font-size: 1rem; color: var(--muted); font-family: var(--font-serif); }
  .one { margin: 0 0 1.25rem; font-size: 0.9375rem; color: var(--muted); line-height: 1.65; }

  .kr { list-style: none; margin: 0 0 1.25rem; padding: 1rem 0 0; border-top: var(--rule); display: grid; gap: 0.5rem; }
  .kr li { display: flex; align-items: baseline; gap: 0.9rem; }
  .kv { font-size: 1rem; min-width: 6.5rem; }
  .kl { font-size: 0.8125rem; color: var(--muted); line-height: 1.45; }

  @media (max-width: 900px) {
    .paper { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
